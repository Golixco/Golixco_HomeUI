# Server-only. Copy to .env.local and paste your key privately.
# Never prefix secrets with VITE_. Restart npm run dev after changing this file.
GEMINI_API_KEY=
# Verified stable, low-latency text model; actual account access needs a real key.
GEMINI_MODEL=gemini-3.5-flash-lite

# Fallback only after confirmed Gemini quota failure. No expensive model default.
BACKBOARD_API_KEY=
BACKBOARD_LLM_PROVIDER=
BACKBOARD_MODEL=
# Requires owner approval of Backboard thread persistence and best-effort cleanup.
BACKBOARD_STORAGE_APPROVED=false
